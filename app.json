{
  "expo": {
    "name": "Medicoo Doctors",
    "slug": "medicoo-doctors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "MedicooDoctors",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0FBBA1",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.medicootech.medicoodoctor",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./firebase/google-services.json"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0FBBA1",
          "dark": {
            "backgroundColor": "#0FBBA1"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Medicoo Doctors needs access to your photos to let you upload credentials, documents, and your profile picture.",
          "cameraPermission": "Medicoo Doctors needs access to your camera to let you scan and upload documents.",
          "microphonePermission": "Medicoo Doctors needs access to your microphone for audio and video consultations with patients."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./src/assets/sounds/incoming_call.wav",
            "./src/assets/sounds/new_notification.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withLowMemoryGradleTuning.js",
      "./plugins/withAgoraScreenShareExclusion.js",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#00000000"
        }
      ],
      "./plugins/withTransparentNavigationBar.js",
      "./plugins/withPictureInPicture.js"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "expo-navigation-bar": {
        "backgroundColor": "#00000000"
      },
      "eas": {
        "projectId": "041a5a69-e3f1-4f28-bd11-59b4f0e7928c"
      }
    },
    "owner": "medicootech-private-limited"
  }
}
